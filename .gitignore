# ===== WHITELIST MODE =====
# Ignore EVERYTHING by default
*

# Allow only the docs directory (deployed site)
!docs/
!docs/**

# Allow build scripts
!build_seo.js
!build_full_pdf.js
!build_metodichka_pdf.js
!ping_crawlers.js

# Allow .gitignore itself
!.gitignore

# Allow source chapters and translation scripts
!chapters_src/
!chapters_src/**
!chapters_en/
!chapters_en/**
!scripts/
!scripts/**

# Allow README
!README.md
